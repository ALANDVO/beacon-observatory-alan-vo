# .env.example — Beacon Observatory Environment Configuration
# Copy to .env and fill in values

# Application
APP_NAME=beacon-observatory
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000
WORKERS=1

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/beacon.db
DATABASE_ECHO=false

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# OIDC / Keycloak (future)
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# LLM Providers (future)
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=

# Demo mode (local development only - binds to localhost)
DEMO_MODE=true
DEMO_MODE_BIND_ADDRESS=127.0.0.1